  "fragment": {
    "entry_point": "mainImage",
    "source": "float tunnelPolygon(vec2 p,float sides) {\n float a=atan(p.y,p.x), sector=6.2831853/sides;\n return cos(floor(.5+a/sector)*sector-a)*length(p);\n}\nvoid mainImage(out vec4 fragColor,in vec2 fragCoord) {\n vec2 p=(2.0*fragCoord-iResolution.xy)/iResolution.y;\n float phase=vrchPhase_speed();\n vec3 color=vec3(.006,.008,.015);\n // Turning p keeps its length and shifts its polar angle, so both are measured once.\n float polar=atan(p.y,p.x),len=length(p);\n float sector=6.2831853/max(3.0,floor(uParam_sides+.5));\n for(int i=0;i<14;i++) {\n  float z=mod(float(i)/14.0+phase*.08,1.0);\n  float radius=.12+2.0*pow(z,1.5);\n  float angle=uParam_twist*(1.0-z)+phase*.04;\n  float a=polar-angle;\n  float d=abs(cos(floor(.5+a/sector)*sector-a)*len-radius);\n  float line=1.0-smoothstep(uParam_width,uParam_width+1.5/iResolution.y,d);\n  float fade=smoothstep(0.0,.08,z)*(1.0-smoothstep(.82,1.0,z));\n  color+=uParam_color.rgb*line*fade*pow(z,uParam_depth)*.8;\n }\n fragColor=vec4(clamp(color,0.0,1.0),1.0);\n}\n"
  },
