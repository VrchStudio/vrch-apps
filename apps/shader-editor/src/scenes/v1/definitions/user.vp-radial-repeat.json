{
  "schema_version": 1,
  "scene_id": "user.vp-radial-repeat",
  "title": "Radial Repeat",
  "description": "A controllable radial mirror for building kaleidoscopic image compositions with a stable centre and continuous rotation.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor,in vec2 fragCoord) {\n vec2 p=(2.0*fragCoord-iResolution.xy)/iResolution.y;\n float phase=vrchPhase_speed(), r=length(p), count=max(3.0,floor(uParam_segments+.5));\n float wedge=6.2831853/count;\n float angle=atan(p.y,p.x)+phase*.22+uParam_rotation+uParam_twist*r;\n angle=abs(mod(angle+wedge*.5,wedge)-wedge*.5);\n vec2 q=vec2(cos(angle),sin(angle))*r/max(uParam_zoom,.1);\n vec2 uv=fract(q*.45+uParam_offset);\n vec4 sampled=vrchSampleSource0(uv);\n fragColor=sampled;\n}\n"
  },
  "parameters": [
    {
      "key": "segments",
      "label": "Segments",
      "type": "float",
      "default": 6,
      "min": 3,
      "max": 12,
      "step": 1,
      "widget": "slider",
      "group": "Look",
      "description": "Number of mirrored sectors."
    },
    {
      "key": "zoom",
      "label": "Scale",
      "type": "float",
      "default": 1.15,
      "min": 0.45,
      "max": 2.5,
      "step": 0.01,
      "widget": "slider",
      "group": "Look",
      "description": "Scale of the repeated source image."
    },
    {
      "key": "twist",
      "label": "Twist",
      "type": "float",
      "default": 0.12,
      "min": -1.2,
      "max": 1.2,
      "step": 0.01,
      "widget": "slider",
      "group": "Look",
      "description": "Radial bending of the mirrored image."
    },
    {
      "key": "rotation",
      "label": "Rotation",
      "type": "float",
      "default": 0.2,
      "min": -3.14,
      "max": 3.14,
      "step": 0.01,
      "widget": "slider",
      "group": "Look",
      "description": "Rotation offset of the whole composition."
    },
    {
      "key": "offset",
      "label": "Source Offset",
      "type": "float",
      "default": 0.34,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "widget": "slider",
      "group": "Look",
      "description": "Position sampled within the source image."
    },
    {
