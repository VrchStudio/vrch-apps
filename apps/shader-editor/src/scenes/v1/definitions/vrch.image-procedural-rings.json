{
  "schema_version": 1,
  "scene_id": "vrch.image-procedural-rings",
  "title": "Breathing Rings",
  "description": "Low-opacity rings expand from a chosen center while the live image remains the clear subject.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 resolution = max(iResolution.xy, vec2(1.0));\n  vec2 uv = fragCoord / resolution;\n  vec4 image = vrchSampleSource0(uv);\n  vec2 aspect = vec2(resolution.x / resolution.y, 1.0);\n  vec2 point = (uv - uParam_center) * aspect;\n  float radius = length(point);\n  float phase = fract(radius * uParam_rings - iTime * uParam_speed);\n  float ringDistance = abs(phase - 0.5);\n  float antialias = max(fwidth(ringDistance) * 1.5, 0.001);\n  float ring = 1.0 - smoothstep(uParam_width, uParam_width + antialias, ringDistance);\n  float falloff = 1.0 - smoothstep(0.12, 1.05, radius);\n  float mask = ring * mix(0.28, 1.0, falloff);\n  vec3 treated = image.rgb + uParam_color.rgb * mask * uParam_brightness;\n  fragColor = vec4(mix(image.rgb, treated, uParam_amount), image.a);\n}"
  },
  "parameters": [
