{
  "schema_version": 1,
  "scene_id": "vrch.procedural-reveal",
  "title": "Procedural Reveal",
  "description": "Moves a soft organic window across Source A to reveal the independent Source B beneath it.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 2,
    "max_sources": 2,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "float vrchRevealHash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\nfloat vrchRevealNoise(vec2 p) {\n  vec2 cell = floor(p);\n  vec2 local = fract(p);\n  vec2 curve = local * local * (3.0 - 2.0 * local);\n  float a = vrchRevealHash(cell);\n  float b = vrchRevealHash(cell + vec2(1.0, 0.0));\n  float c = vrchRevealHash(cell + vec2(0.0, 1.0));\n  float d = vrchRevealHash(cell + vec2(1.0, 1.0));\n  return mix(mix(a, b, curve.x), mix(c, d, curve.x), curve.y);\n}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec4 sourceA = vrchSampleSource0(uv);\n  vec4 sourceB = vrchSampleSource1(uv);\n  vec2 aspect = vec2(iResolution.x / max(iResolution.y, 1.0), 1.0);\n  vec2 center = vec2(0.5 + sin(vrchPhase_motion() * 0.83) * 0.24, 0.5 + cos(vrchPhase_motion() * 0.61) * 0.2);\n  vec2 delta = (uv - center) * aspect;\n  float distanceField = length(delta);\n  float distortion = (vrchRevealNoise(uv * 5.0 + vrchPhase_motion() * 0.18) - 0.5) * uParam_texture;\n  float radius = uParam_size;\n  float mask = 1.0 - smoothstep(radius - uParam_feather, radius + uParam_feather, distanceField + distortion);\n  mask = clamp(mask * uParam_amount, 0.0, 1.0);\n  fragColor = vec4(mix(sourceA.rgb, sourceB.rgb, mask), mix(sourceA.a, sourceB.a, mask));\n}"
  },
