{
  "schema_version": 1,
  "scene_id": "vrch.halftone-dot",
  "title": "Halftone Dots",
  "description": "Turns an image into clean print-like dots while keeping the subject readable.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "float vrchCoverageRadius(float coverage) {\n  return sqrt(coverage / 3.14159265359) + 0.145 * pow(smoothstep(0.785, 1.0, coverage), 3.0);\n}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  float density = uParam_density;\n  vec2 aspect = vec2(iResolution.x / iResolution.y, 1.0);\n  vec2 cellUv = uv * aspect * density;\n  vec2 cellId = floor(cellUv);\n  vec2 centerUv = (cellId + 0.5) / (aspect * density);\n  vec4 image = vrchSampleSource0(centerUv);\n  float luma = dot(image.rgb, vec3(0.2126, 0.7152, 0.0722));\n  float radius = vrchCoverageRadius(1.0 - pow(clamp(luma * uParam_contrast, 0.0, 1.0), uParam_shape));\n  float distanceToCenter = length(fract(cellUv) - 0.5);\n  float edge = fwidth(distanceToCenter) * 1.5;\n  float ink = 1.0 - smoothstep(radius - edge, radius + edge, distanceToCenter);\n  vec3 printColor = mix(uParam_paper.rgb, uParam_ink.rgb, ink);\n  fragColor = vec4(mix(image.rgb, printColor, uParam_amount), image.a);\n}"
  },
