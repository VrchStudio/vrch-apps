{
  "schema_version": 1,
  "scene_id": "vrch.halftone-circle",
  "title": "Halftone Circles",
  "description": "Rebuilds image tone with restrained concentric ink rings centered on the frame.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec4 image = vrchSampleSource0(uv);\n  float luma = dot(image.rgb, vec3(0.2126, 0.7152, 0.0722));\n  vec2 point = (uv - 0.5) * vec2(iResolution.x / iResolution.y, 1.0);\n  float radius = length(point);\n  float phaseOffset = uParam_phase + iTime * uParam_motion;\n  float ringPhase = abs(fract(radius * uParam_rings - phaseOffset) - 0.5) * 2.0;\n  float tonalWidth = clamp(uParam_width + (1.0 - luma) * uParam_contrast, 0.04, 0.92);\n  float antialias = max(fwidth(ringPhase) * 1.25, 0.002);\n  float inkMask = 1.0 - smoothstep(tonalWidth - antialias, tonalWidth + antialias, ringPhase);\n  vec3 paperTone = uParam_paper.rgb;\n  vec3 inkTone = mix(uParam_ink.rgb * (0.35 + luma * 0.65), image.rgb, 0.52);\n  vec3 printed = mix(paperTone, inkTone, inkMask);\n  float treatment = uParam_amount;\n  fragColor = vec4(mix(image.rgb, printed, treatment), image.a);\n}"
  },
