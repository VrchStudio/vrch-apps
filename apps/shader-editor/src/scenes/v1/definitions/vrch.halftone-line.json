{
  "schema_version": 1,
  "scene_id": "vrch.halftone-line",
  "title": "Halftone Lines",
  "description": "Expresses continuous image tone through clean, angle-adjustable print lines.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec4 image = vrchSampleSource0(uv);\n  float luma = dot(image.rgb, vec3(0.2126, 0.7152, 0.0722));\n  vec2 point = (uv - 0.5) * vec2(iResolution.x / iResolution.y, 1.0);\n  float angle = uParam_angle * 6.28318530718;\n  float cs = cos(angle);\n  float sn = sin(angle);\n  vec2 rotated = vec2(point.x * cs - point.y * sn, point.x * sn + point.y * cs);\n  float phaseTravel = vrchPhase_motion();\n  float phase = abs(fract(rotated.y * uParam_spacing - phaseTravel) - 0.5) * 2.0;\n  float tonalWidth = clamp(uParam_width + (1.0 - luma) * uParam_contrast, 0.04, 0.94);\n  float antialias = max(fwidth(phase) * 1.25, 0.002);\n  float inkMask = 1.0 - smoothstep(tonalWidth - antialias, tonalWidth + antialias, phase);\n  vec3 printed = mix(uParam_paper.rgb, uParam_ink.rgb, inkMask);\n  fragColor = vec4(mix(image.rgb, printed, uParam_amount), image.a);\n}"
  },
