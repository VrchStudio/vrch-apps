{
  "schema_version": 1,
  "scene_id": "vrch.bitmap",
  "title": "Pixel Bitmap",
  "description": "Reduces an image to a crisp low-resolution monochrome bitmap with stable ordered texture.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "float vrchBitmapThreshold(vec2 cell) {\n  vec2 local = mod(cell, 4.0);\n  return fract((local.x * 2.0 + local.y * 3.0 + local.x * local.y) * 0.25);\n}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec2 aspect = vec2(iResolution.x / iResolution.y, 1.0);\n  vec2 grid = uv * aspect * uParam_pixels;\n  vec2 cell = floor(grid);\n  vec2 sampleUv = (cell + 0.5) / (aspect * uParam_pixels);\n  vec4 image = vrchSampleSource0(sampleUv);\n  float luma = dot(image.rgb, vec3(0.2126, 0.7152, 0.0722));\n  float levels = max(2.0, uParam_levels);\n  float threshold = (vrchBitmapThreshold(cell) - 0.5) * uParam_dither / levels;\n  float quantized = floor(clamp(luma + threshold, 0.0, 1.0) * (levels - 1.0) + 0.5) / (levels - 1.0);\n  vec3 bitmapColor = mix(uParam_ink.rgb, uParam_paper.rgb, quantized);\n  fragColor = vec4(mix(image.rgb, bitmapColor, uParam_amount), image.a);\n}"
  },
