{
  "schema_version": 1,
  "scene_id": "vrch.conformance-blend",
  "title": "Conformance Blend",
  "description": "Two-source soft-light blend used to qualify both source helpers and audio modulation.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 2,
    "max_sources": 2,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec4 a = vrchSampleSource0(uv);\n  vec4 b = vrchSampleSource1(uv);\n  float reactive = vrchReadSignal(0);\n  float blendAmount = clamp(uParam_mix + reactive * uParam_audio, 0.0, 1.0);\n  vec3 screenColor = 1.0 - (1.0 - a.rgb) * (1.0 - b.rgb);\n  fragColor = vec4(mix(a.rgb, screenColor, blendAmount), mix(a.a, b.a, blendAmount));\n}"
  },
