{
  "schema_version": 1,
  "scene_id": "vrch.patchwork",
  "title": "Patchwork",
  "description": "Reassembles an image from bounded horizontal strips and offset blocks that can respond to a beat.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "float vrchPatchHash(vec2 point) {\n  return fract(sin(dot(point, vec2(31.41, 97.17))) * 43758.5453);\n}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  float stripId = floor(uv.y * uParam_strips);\n  float blockId = floor(uv.x * uParam_blocks);\n  float stripShift = (vrchPatchHash(vec2(stripId, 3.0)) - 0.5) * 2.0 * uParam_offset;\n  float blockShift = (vrchPatchHash(vec2(blockId, stripId)) - 0.5) * uParam_jitter / uParam_strips;\n  vec2 patchUv = vec2(fract(uv.x + stripShift), clamp(uv.y + blockShift, 0.0, 1.0));\n  vec4 image = vrchSampleSource0(uv);\n  vec4 patched = vrchSampleSource0(patchUv);\n  float seamX = min(fract(uv.x * uParam_blocks), 1.0 - fract(uv.x * uParam_blocks));\n  float seamY = min(fract(uv.y * uParam_strips), 1.0 - fract(uv.y * uParam_strips));\n  float seam = 1.0 - smoothstep(0.0, 0.018, min(seamX, seamY));\n  vec3 assembled = patched.rgb * (1.0 - seam * uParam_seams);\n  fragColor = vec4(mix(image.rgb, assembled, uParam_amount), image.a);\n}"
  },
