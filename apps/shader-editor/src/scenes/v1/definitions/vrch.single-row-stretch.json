{
  "schema_version": 1,
  "scene_id": "vrch.single-row-stretch",
  "title": "Row Stretch",
  "description": "Selects one horizontal image row and stretches it into a graphic band without losing the surrounding frame.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec4 image = vrchSampleSource0(uv);\n  float motionWave = sin(iTime * (0.45 + uParam_motion * 0.85));\n  float rowPosition = clamp(uParam_position + motionWave * uParam_motion * 0.28, 0.05, 0.95);\n  float halfWidth = max(0.002, uParam_band_width * 0.5);\n  float distanceToBand = abs(uv.y - rowPosition);\n  float feather = max(0.001, halfWidth * uParam_feather);\n  float bandMask = 1.0 - smoothstep(halfWidth - feather, halfWidth + feather, distanceToBand);\n  float selectedY = mix(uv.y, rowPosition, uParam_stretch);\n  float cell = floor(uv.x * uParam_segments);\n  float segmentShift = (fract(sin(cell * 71.13) * 43758.5453) - 0.5) * uParam_fragment / uParam_segments;\n  vec2 stretchedUv = vec2(clamp(uv.x + segmentShift * bandMask, 0.0, 1.0), clamp(selectedY, 0.0, 1.0));\n  vec4 stretched = vrchSampleSource0(stretchedUv);\n  float applied = bandMask * uParam_amount;\n  fragColor = vec4(mix(image.rgb, stretched.rgb, applied), image.a);\n}"
  },
