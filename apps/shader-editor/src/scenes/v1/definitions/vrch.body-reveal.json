{
  "schema_version": 1,
  "scene_id": "vrch.body-reveal",
  "title": "Body Reveal",
  "description": "Reveals the tracked body from Source B through Source A.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 2,
    "max_sources": 2,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / max(iResolution.xy, vec2(1.0));\n  vec4 sourceA = vrchSampleSource0(uv);\n  vec4 sourceB = vrchSampleSource1(uv);\n  float confidence = vrchReadSignal(0);\n  vec2 center = vec2(vrchReadSignal(1), vrchReadSignal(2));\n  vec2 size = vec2(max(0.05, uParam_body_width), max(0.08, uParam_body_height));\n  float distanceToBody = length((uv - center) / size);\n  float softness = max(0.01, uParam_softness);\n  float mask = 1.0 - smoothstep(1.0 - softness, 1.0 + softness, distanceToBody);\n  mask *= uParam_reveal * confidence;\n  vec3 color = mix(sourceA.rgb, sourceB.rgb, clamp(mask, 0.0, 1.0));\n  vec4 tracking = vrchSampleSignalTexture(0, uv);\n  color += uParam_skeleton_color.rgb * tracking.a * uParam_skeleton * confidence * 0.4;\n  fragColor = vec4(color, mix(sourceA.a, sourceB.a, clamp(mask, 0.0, 1.0)));\n}"
  },
