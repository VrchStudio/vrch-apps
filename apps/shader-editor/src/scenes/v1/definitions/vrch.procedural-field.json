  "fragment": {
    "entry_point": "mainImage",
    "source": "float vrchFieldHash(vec2 p) {\n  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\nfloat vrchFieldNoise(vec2 p) {\n  vec2 i = floor(p);\n  vec2 f = fract(p);\n  f = f * f * (3.0 - 2.0 * f);\n  float a = vrchFieldHash(i);\n  float b = vrchFieldHash(i + vec2(1.0, 0.0));\n  float c = vrchFieldHash(i + vec2(0.0, 1.0));\n  float d = vrchFieldHash(i + vec2(1.0, 1.0));\n  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\nfloat vrchFieldFbm(vec2 p) {\n  float value = 0.0;\n  float weight = 0.5;\n  for (int i = 0; i < 5; i++) {\n    value += weight * vrchFieldNoise(p);\n    p = mat2(1.62, -1.17, 1.17, 1.62) * p + 0.17;\n    weight *= 0.5;\n  }\n  return value;\n}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec2 p = (uv - 0.5) * vec2(iResolution.x / iResolution.y, 1.0) * uParam_scale;\n  float time = vrchPhase_speed();\n  float first = vrchFieldFbm(p + vec2(time * 0.14, -time * 0.09));\n  float second = vrchFieldFbm(p * 1.7 - vec2(time * 0.08, time * 0.12) + first);\n  float light = smoothstep(0.18, 0.92, mix(first, second, uParam_complexity));\n  light = clamp(light, 0.0, 1.0);\n  vec3 color = mix(uParam_color_a.rgb, uParam_color_b.rgb, light);\n  color += uParam_glow * pow(light, 3.0) * uParam_color_b.rgb;\n  fragColor = vec4(color, 1.0);\n}"
  },
