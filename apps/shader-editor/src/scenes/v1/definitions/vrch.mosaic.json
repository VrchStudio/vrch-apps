{
  "schema_version": 1,
  "scene_id": "vrch.mosaic",
  "title": "Mosaic",
  "description": "A stable, crisp pixel mosaic whose optional separation belongs to each sampled block.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 resolution = max(iResolution.xy, vec2(1.0));\n  vec2 uv = fragCoord / resolution;\n  vec4 source = vrchSampleSource0(uv);\n  vec2 aspect = vec2(resolution.x / resolution.y, 1.0);\n  vec2 gridUv = uv * aspect * uParam_blocks;\n  vec2 cell = floor(gridUv);\n  vec2 local = fract(gridUv) - 0.5;\n  vec2 sampleUv = (cell + 0.5) / (aspect * uParam_blocks);\n  vec4 cellSample = vrchSampleSource0(sampleUv);\n  float responseInput = clamp(uParam_response, 0.0, 1.0);\n  float response = pow(responseInput, 0.35) * smoothstep(0.012, 0.03, responseInput);\n  float reducedLevels = max(3.0, uParam_levels * 0.2);\n  float levels = mix(uParam_levels, reducedLevels, response);\n  vec3 quantized = floor(cellSample.rgb * levels + 0.5) / levels;\n  float corner = max(abs(local.x), abs(local.y));\n  float separation = clamp(uParam_separation + response * 1.35, 0.0, 1.0);\n  float edgeWidth = max(fwidth(corner) * 1.25, 0.001) + 0.11 * separation;\n  float edge = smoothstep(0.5 - edgeWidth, 0.5, corner) * separation;\n  vec3 mosaic = quantized * (1.0 - 0.5 * edge);\n  fragColor = vec4(mix(source.rgb, mosaic, uParam_amount), source.a);\n}"
  },
