{
  "schema_version": 1,
  "scene_id": "vrch.channel-shift",
  "title": "Channel Shift",
  "description": "Separates color channels around image edges with a controlled, stage-safe offset.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  float angle = uParam_angle * 6.28318530718;\n  float separation = uParam_offset;\n  vec2 direction = vec2(cos(angle), sin(angle));\n  vec2 offset = direction * separation / min(iResolution.x, iResolution.y);\n  vec4 center = vrchSampleSource0(uv);\n  vec4 redSample = vrchSampleSource0(uv + offset);\n  vec4 blueSample = vrchSampleSource0(uv - offset);\n  vec3 shifted = vec3(redSample.r, center.g, blueSample.b);\n  float edge = length(redSample.rgb - blueSample.rgb);\n  shifted += uParam_glow * edge * vec3(0.18, 0.04, 0.24);\n  fragColor = vec4(mix(center.rgb, shifted, uParam_amount), center.a);\n}"
  },
  "parameters": [
    {
      "key": "amount",
      "label": "Effect",
      "type": "float",
      "default": 0.78,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "widget": "slider",
      "group": "Look",
      "description": "Strength of the channel separation."
    },
    {
      "key": "offset",
      "label": "Distance",
      "type": "float",
      "default": 4,
      "min": 0.0,
      "max": 32.0,
      "step": 0.5,
      "widget": "slider",
      "group": "Look",
      "description": "Normalized separation distance."
    },
    {
