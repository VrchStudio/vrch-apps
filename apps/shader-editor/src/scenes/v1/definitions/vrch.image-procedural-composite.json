{
  "schema_version": 1,
  "scene_id": "vrch.image-procedural-composite",
  "title": "Living Grid",
  "description": "Keeps one image dominant while a thin moving grid and restrained light sweep sit above it.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec4 image = vrchSampleSource0(uv);\n  vec2 aspect = vec2(iResolution.x / iResolution.y, 1.0);\n  vec2 moving = uv * aspect * uParam_scale + vec2(vrchPhase_speed(), -vrchPhase_speed() * 0.37);\n  vec2 lineDistance = abs(fract(moving) - 0.5);\n  float gridDistance = min(lineDistance.x, lineDistance.y);\n  float grid = 1.0 - smoothstep(uParam_width, uParam_width + fwidth(gridDistance), gridDistance);\n  float sweep = pow(max(0.0, sin((uv.x + uv.y) * 4.0 - vrchPhase_speed() * 2.0)), 8.0);\n  float mask = grid * (.16 + sweep * (1.0 + uParam_sweep));\n  vec3 overlay = image.rgb + uParam_color.rgb * mask * uParam_brightness;\n  fragColor = vec4(mix(image.rgb, overlay, uParam_amount), image.a);\n}"
  },
