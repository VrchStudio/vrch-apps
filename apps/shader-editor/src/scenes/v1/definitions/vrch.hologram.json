  "schema_version": 1,
  "scene_id": "vrch.hologram",
  "title": "Hologram",
  "description": "Adds cool spectral color, animated scanlines and restrained chromatic warp while retaining the source image.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  float motionPhase = vrchPhase_speed();\n  float warp = sin(uv.y * 14.0 + motionPhase * 1.1) * uParam_warp;\n  vec2 warpedUv = vec2(clamp(uv.x + warp, 0.0, 1.0), uv.y);\n  float liveSplit = uParam_color_shift;\n  vec2 colorOffset = vec2(liveSplit / min(iResolution.x, iResolution.y), 0.0);\n  vec4 center = vrchSampleSource0(warpedUv);\n  float red = vrchSampleSource0(clamp(warpedUv + colorOffset, vec2(0.0), vec2(1.0))).r;\n  float blue = vrchSampleSource0(clamp(warpedUv - colorOffset, vec2(0.0), vec2(1.0))).b;\n  float luma = dot(center.rgb, vec3(0.2126, 0.7152, 0.0722));\n  float scan = 0.5 + 0.5 * sin((uv.y * uParam_scanlines - motionPhase * 0.25) * 6.28318530718);\n  float scanLight = mix(0.76, 1.06, scan);\n  float flicker = 1.0 - 0.06 * (0.5 + 0.5 * sin(motionPhase * 3.0 + uv.y * 2.0));\n  vec3 spectral = mix(vec3(red, center.g, blue), uParam_tint.rgb * (0.32 + luma * 1.15), 0.68);\n  spectral *= scanLight * flicker;\n  float liveGlow = uParam_glow;\n  float bandCenter = 0.5 + 0.26 * sin(motionPhase * 0.45);\n  float bandDistance = (uv.y - bandCenter) / 0.065;\n  float scanBand = exp(-bandDistance * bandDistance);\n  spectral += liveGlow * uParam_tint.rgb * (luma * 0.10 + scanBand * (0.20 + luma * 0.85));\n  fragColor = vec4(mix(center.rgb, clamp(spectral, 0.0, 1.0), uParam_amount), center.a);\n}"
  },
