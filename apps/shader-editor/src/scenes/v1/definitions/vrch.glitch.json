{
  "schema_version": 1,
  "scene_id": "vrch.glitch",
  "title": "Soft Glitch",
  "description": "Time-based horizontal tears and block shifts with a restrained, light-safe default.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "float vrchGlitchHash(vec2 p) {\n  return fract(sin(dot(p, vec2(41.31, 289.17))) * 15731.743);\n}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  float timeStep = floor(vrchPhase_rate());\n  float row = floor(uv.y * uParam_blocks);\n  float randomValue = vrchGlitchHash(vec2(row, timeStep));\n  float tearActive = step(1.0 - clamp(uParam_intensity, 0.0, 0.72), randomValue);\n  float signedShift = (vrchGlitchHash(vec2(row + 19.0, timeStep)) - 0.5) * 2.0;\n  vec2 shiftedUv = uv + vec2(tearActive * signedShift * uParam_tear, 0.0);\n  vec4 image = vrchSampleSource0(shiftedUv);\n  vec2 colorOffset = vec2(tearActive * signedShift * uParam_color_shift, 0.0);\n  float red = vrchSampleSource0(shiftedUv + colorOffset).r;\n  float blue = vrchSampleSource0(shiftedUv - colorOffset).b;\n  vec3 color = vec3(red, image.g, blue);\n  float scanline = 0.985 + 0.015 * sin(uv.y * iResolution.y * 1.4);\n  fragColor = vec4(mix(image.rgb, color * scanline, uParam_amount), image.a);\n}"
  },
