  "schema_version": 1,
  "scene_id": "vrch.stamp",
  "title": "Stamp",
  "description": "Creates a bold two-color rubber-stamp image with deterministic grain and uneven ink edges.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 1,
    "max_sources": 1,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "float vrchStampHash(vec2 point) {\n  return fract(sin(dot(point, vec2(73.13, 19.71))) * 43758.5453);\n}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec2 pixelStep = vec2(1.0 + uParam_spread * 3.0) / iResolution.xy;\n  vec4 image = vrchSampleSource0(uv);\n  vec2 inkUv = clamp(uv - vec2(uParam_registration / min(iResolution.x, iResolution.y), 0.0), vec2(0.0), vec2(1.0));\n  float centerLuma = dot(vrchSampleSource0(inkUv).rgb, vec3(0.2126, 0.7152, 0.0722));\n  float nearbyLuma = dot(vrchSampleSource0(inkUv + vec2(pixelStep.x, 0.0)).rgb, vec3(0.2126, 0.7152, 0.0722));\n  nearbyLuma += dot(vrchSampleSource0(inkUv - vec2(pixelStep.x, 0.0)).rgb, vec3(0.2126, 0.7152, 0.0722));\n  nearbyLuma += dot(vrchSampleSource0(inkUv + vec2(0.0, pixelStep.y)).rgb, vec3(0.2126, 0.7152, 0.0722));\n  nearbyLuma += dot(vrchSampleSource0(inkUv - vec2(0.0, pixelStep.y)).rgb, vec3(0.2126, 0.7152, 0.0722));\n  nearbyLuma *= 0.25;\n  float spreadLuma = mix(centerLuma, min(centerLuma, nearbyLuma), uParam_spread);\n  float grain = vrchStampHash(floor(fragCoord / 2.0)) - 0.5;\n  float threshold = clamp(uParam_threshold + grain * uParam_grain, 0.05, 0.95);\n  float antialias = max(fwidth(spreadLuma) * (1.0 + uParam_edge), 0.002);\n  float inkMask = 1.0 - smoothstep(threshold - antialias, threshold + antialias, spreadLuma);\n  vec3 stamped = mix(uParam_paper.rgb, uParam_ink.rgb, inkMask);\n  fragColor = vec4(mix(image.rgb, stamped, uParam_amount), image.a);\n}"
  },
