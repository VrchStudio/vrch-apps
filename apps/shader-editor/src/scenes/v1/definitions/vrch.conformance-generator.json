{
  "schema_version": 1,
  "scene_id": "vrch.conformance-generator",
  "title": "Conformance Generator",
  "description": "Zero-source procedural color field used to qualify the Scene Runtime ABI.",
  "runtime": {
    "abi": "vrch-mainimage",
    "abi_version": 1,
    "glsl": "300-es",
    "min_sources": 0,
    "max_sources": 0,
    "alpha_mode": "straight",
    "working_color_space": "linear-srgb",
    "missing_source_policy": "defined-fallback"
  },
  "fragment": {
    "entry_point": "mainImage",
    "source": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec2 p = (uv - 0.5) * vec2(iResolution.x / iResolution.y, 1.0);\n  float wave = 0.5 + 0.5 * sin(length(p) * uParam_density - iTime * uParam_speed);\n  vec3 tint = uParam_tint.rgb * (0.25 + 0.75 * wave);\n  fragColor = vec4(tint, 1.0);\n}"
  },
  "parameters": [
    {
      "key": "density",
      "label": "Density",
      "type": "float",
      "default": 28.0,
      "min": 4.0,
      "max": 64.0,
      "step": 1.0,
      "widget": "slider",
      "group": "Look",
      "description": "Number of radial bands."
    },
    {
      "key": "speed",
      "label": "Motion",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "widget": "slider",
      "group": "Motion",
      "description": "Animation speed."
    },
