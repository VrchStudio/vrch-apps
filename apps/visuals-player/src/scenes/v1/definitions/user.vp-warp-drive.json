  "fragment": {
    "entry_point": "mainImage",
    "source": "float warpHash(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453);}\nvoid mainImage(out vec4 fragColor,in vec2 fragCoord){\n vec2 p=(fragCoord-.5*iResolution.xy)/iResolution.y;\n float aspect=iResolution.x/iResolution.y,pix=1.0/iResolution.y;\n float t=vrchPhase_speed();\n float strike=smoothstep(0.0,.85,uParam_accent);\n // Steering: the vanishing point follows the midpoint of the hands.\n float pres=clamp(uParam_presence,0.0,1.0);\n vec2 hand=clamp(vec2(uParam_hand_x,uParam_hand_y)/max(pres,.001),0.0,1.0)-.5;\n vec2 center=hand*vec2(aspect,1.0)*.55*pres*uParam_steer;\n vec2 q=p-center;\n float r=max(length(q),.0005);\n float lr=log(r);\n float a=atan(q.y,q.x)+uParam_twist*.5*(lr+2.5)+t*.015;\n vec3 ink=uParam_color.rgb;\n vec3 c=vec3(0.0);\n float tail=.05+uParam_streak*.4+.4*strike;\n float density=.08+uParam_density*.3;\n for(int l=0;l<3;l++){\n  float fl=float(l);\n  float sectors=150.0+fl*90.0;\n  float sa=(a/6.2831853+.5)*sectors;\n  float cell=floor(sa);\n  float offset=warpHash(vec2(cell,fl*17.0+3.0));\n  // Each angular lane has its own depth offset, so heads never line up in rings.\n  float z=lr*1.4-t*(1.0+fl*.3)+offset*11.0;\n  float zcell=floor(z);\n  if(warpHash(vec2(cell+fl*131.0,zcell))>density)continue;\n  float fa=fract(sa)-.5;\n  float zc=fract(z)-.75;\n  float body=pow(smoothstep(-tail,0.0,zc),2.0)*(1.0-smoothstep(0.0,.01,zc));\n  float head=exp(-max(zc,0.0)*120.0)*step(-.002,zc);\n  float across=abs(fa)*6.2831853*r/sectors;\n  float w=max(pix*.5,.0004+.0022*r);\n  float line=exp(-across*across/(w*w));\n  float near=smoothstep(.03,.7,r);\n  float sparkle=1.0+uParam_twinkle*2.5*pow(abs(warpHash(vec2(cell,zcell+fl*7.0))),8.0);\n  c+=ink*line*(body*.5+head*1.6)*near*sparkle*(1.0+1.0*strike);\n }\n // Faint volumetric shafts give the tunnel depth without greying the black.\n float shafts=pow(abs(.5+.5*sin(a*5.0+sin(a*3.0+t*.1)*2.0)),6.0);\n c+=ink*shafts*smoothstep(.1,1.0,r)*.006*(.5+uParam_streak);\n // White-hot core at the vanishing point.\n c+=mix(ink,vec3(1.0),.7)*(.004/(r+.004)*.2+exp(-r*r*2500.0)*.6);\n float ringR=.06+(1.0-strike)*1.1;\n c+=ink*strike*strike*exp(-abs(r-ringR)*60.0)*.22;\n c*=.55+uParam_glow*1.1;\n fragColor=vec4(1.0-exp(-c*1.3),1.0);\n}\n"
  },
